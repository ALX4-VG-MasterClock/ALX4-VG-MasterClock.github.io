La salle le dit plutôt que de se remplir : quand une première question réelle publiable arrivera, elle paraîtra ici, nettoyée, avec sa pièce.","mots":["la","salle","des","echos","les","questions","qu","on","a","posees","au","site","ici","le","site","montre","les","questions","reelles","qu","on","lui","a","posees","par","la","porte","du","courriel","le","seul","relais","qui","existe","vers","sophia","l","agente","et","la","piece","qui","repond","a","chacune","un","echo","c","est","une","question","reelle","nettoyee","de","toute","donnee","personnelle","aucun","nom","aucune","adresse","courriel","aucun","detail","identifiable","sa","date","quand","la","source","la","porte","et","le","renvoi","a","l","endroit","du","site","qui","y","repond","les","echos","sont","rassembles","a","la","construction","du","site","dans","un","seul","fichier","assets","echos","json","depuis","la","liste","des","questions","reelles","publiables","consignees","au","journal","de","la","messagerie","du","site","relu","et","nettoye","avant","publication","jamais","collecte","cote","visiteur","cette","page","ne","recoit","rien","elle","lit","un","fichier","aucune","question","inventee","aucun","exemple","fictif","presente","comme","reel","ne","remplit","la","salle","les","echos","publies","aucun","echo","publie","pour","l","instant","lecture","des","echos","du","site","en","cours","borne","ecrite","et","tenue","a","ce","jour","le","journal","de","la","messagerie","du","site","ne","consigne","que","des","messages","d","epreuve","de","nos","propres","boites","et","des","avis","automatises","aucune","question","de","visiteur","reelle","publiable","la","salle","le","dit","plutot","que","de","se","remplir","quand","une","premiere","question","reelle","publiable","arrivera","elle","paraitra","ici","nettoyee","avec","sa","piece"],"empreinte":"effa3b2956817b7b830c34a3b1b357b340f724bdba120df6e1f82b9b6e88e310","merkle":{"feuille":212,"chemin":[{"cote":"gauche","digest":"ca42136f9ceabb101d0add46515e20bc8bf4