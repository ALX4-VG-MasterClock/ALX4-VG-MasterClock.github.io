utorite","de","controle","ou","au","tribunal","dun","bradstreet","c-203","22","n","17"],"empreinte":"34b9e16dcb1064e4f9867d7c852e162c7feeddbdc8f1a1a02e765fffe2bfb904","merkle":{"feuille":57,"chemin":[{"cote":"gauche","digest":"0f914918fd8790427c62279bedd0766b1ca82bb90e114fe771ca6aab88af0268"},{"cote":"droite","digest":"09e6d78f0d7bb7c2e311f6f75e0dbed7d458484d3a17fe4f90d4df7126c690ed"},{"cote":"droite","digest":"65aae9545d77d0a53164c290f535519966cc6c14557d0ac200d7a0d451ca4b42"},{"cote":"gauche","digest":"a37f23cfa9248d54fbcea9a8729d596f4be8c258418d5d38d48a4916ccfced3e"},{"cote":"gauche","digest":"cf5b268a319349c3b584ae05e70edc968c1422cb7f9649a2448c4d63e9e3bd99"},{"cote":"gauche","digest":"55fee940734b458d1c9e3898cc0692f3b5cd586083757167b16b274ce87f2817"},{"cote":"droite","digest":"ba45ce6ff6c9459539eb8e36f654bb04efdfb0657b1f96d714f80e130f40fe28"},{"cote":"droite","digest":"1b65fe30398d27092aa2f9c3f7676704539d0c46eccad31cb93550bae8d57f8b"}]}},{"id":58,"page":"explication.html","ancre":"explication-parcours","titre":"Le parcours, en quatre pas","panneau":"Demander l’explication d’une décision automatisée","texte":"2 Le parcours, en quatre pas Pas 1 — Établis que la décision est automatisée. La décision t'a été annoncée sans explication humaine, par un système (refus, score, classement, fermeture) : les trois textes s'appliquent aux décisions fondées exclusivement sur un traitement automatisé. Garde l'avis de décision : c'est ta pièce. Pas 2 — Demande par écrit, avec le générateur ci-dessous. La demande vise les trois informations de l'article (renseignements utilisés ; raisons, principaux facteurs et paramètres ; droit de rectification) et ton droit de présenter tes observations à une personne en mesure de réviser. Pas 3 — Consigne la demande dans ton cerveau, avec son échéance. Le bouton de consignation scelle la démarche et calcule l'échéance de suivi à 30 jours — le délai de réponse d'une demande d'accès (art. 32 LRPSP ; art. 8 LPRPDE au fédéral) — avec un rappel .ics généré chez toi. Le silence au-delà du délai se consigne aussi : c'est le registre des non de ton dossier de suivi . Pas 4 — Si la réponse ne vient pas ou ne suffit pas. Au Québec, la demande d'examen à la Commission d'accès à l'information (art. 42 LRPSP, dans les 30 jours du refus ou de l'expiration du délai) ; la rectification des renseignements utilisés reste ouverte en tout temps, et c'est elle qui change la prochaine décision.","mots":["2","le","parcours","en","quatre","pas","pas","1","etablis","que","la","decision","est","automatisee","la","decision","t'a","ete","annoncee","sans","explication","humaine","par","un","systeme","refus","score","classement","fermeture","les","trois","textes","s'appliquent","aux","decisions","fondees","exclusivement","sur","un","traitement","automatise","garde","l'avis","de","decision","c'est","ta","piece","pas","2","demande","par","ecrit","avec","le","generateur","ci-dessous","la","demande","vise","les","trois","informations","de","l'article","renseignements","utilises","raisons","principaux","facteurs","et","parametres","droit","de","rectification","et","ton","droit","de","presenter","tes","observations","a","une","personne","en","mesure","de","reviser","pas","3","consigne","la","demande","dans","ton","cerveau","avec","son","echeance","le","bouton","de","consignation","scelle","la","demarche","et","calcule","l'echeance","de","suivi","a","30","jours","le","delai","de","reponse","d'une","demande","d'acces","art","32","lrpsp","art","8","lprpde","au","federal","avec","un","rappel","ics","genere","chez","toi","le","silence","au-dela","du","delai","se","consigne","aussi","c'est","le","registre","des","non","de","ton","dossier","de","suivi","pas","4","si","la","reponse","ne","vient","pas","ou","ne","suffit","pas","au","quebec","la","demande","d'examen","a","la","commission","d'acces","a","l'information","art","42","lrpsp","dans","les","30","jours","du","refus","ou","de","l'expiration","du","delai","la","rectification","des","renseignements","utilises","reste","ouverte","en","tout","temps","et","c'est","elle","qui","change","la","prochaine","decision"],"empreinte":"c8a66a7ae450e25ed9b9e3364fd4d3696b76c31484ee4192c2f8eda2d7ac8c42","merkle":{"feuille":58,"chemin":[{"cote":"droite","digest":"2d61db319388259ac0dec035e84a53e778ddb83017bb710f5fd5c8c8cd746a15"},{"cote":"gauche","digest":"4eb3ede35f719825a316028f739f88ddaed076f5355a0cc76483b729626b9636"},{"cote":"droite","digest":"65aae9545d77d0a53164c290f535519966cc6c14557d0ac200d7a0d451ca4b42"},{"cote":"gauche","digest":"a37f23cfa9248d54fbcea9a8729d596f4be8c258418d5d38d48a4916ccfced3e"},{"cote":"gauche","digest":"cf5b268a319349c3b584ae05e70edc968c1422cb7f9649a2448c4d63e9e3bd99"},{"cote":"gauche","digest":"55fee940734b458d1c9e3898cc0692f3b5cd586083757167b16b274ce87f2817"},{"cote":"droite","digest":"ba45ce6ff6c9459539eb8e36f654bb04efdfb0657b1f96d714f80e130f40fe28"},{"cote":"droite","digest":"1b65fe30398d27092aa2f9c3f7676704539d0c46eccad31cb93550bae8d57f8b"}]}},{"id":59,"page":"explication.html","ancre":"explication-generateur","titre":"Le générateur — ta demande, produite chez toi","panneau":"Demander l’explication d’une décision automatisée","texte":"3 Le générateur — ta demande, produite chez toi Rien ne quitte cet onglet : la lettre se compose dans ton navigateur, comme toutes les lettres de ce site. Choisis le régime selon qui a décidé, décris la décision en une phrase, puis produis. Générateur de demande d'explication — rien ne quitte cet onglet Qui a rendu la décision Une entreprise (secteur privé) — LRPSP, art. 12.1 Un organisme public — Loi sur l'accès, art. 65.2 Un organisme de santé — LRSS, art. 65 Ton nom L'organisation qui a décidé La date de la décision (si tu la connais) La décision, en une phrase Je veux aussi présenter mes observations à une personne en mesure de réviser la décision Produire la demande Ta demande La demande ne vit que dans cet onglet, comme les lettres du panneau Mes renseignements. Copier Télécharger (.txt) Imprimer / PDF L'horloge des droits Une fois la demande envoyée, consigne-la : elle devient une démarche scellée de ton cerveau, avec son échéance de suivi à 30 jours et son rappel .ics. Consigner la demande dans mon cerveau + échéance Télécharger le rappel .ics","mots":["3","le","generateur","ta","demande","produite","chez","toi","rien","ne","quitte","cet","onglet","la","lettre","se","compose","dans","ton","navigateur","comme","toutes","les","lettres","de","ce","site","choisis","le","regime","selon","qui","a","decide","decris","la","decision","en","une","phrase","puis","produis","generateur","de","demande","d'explication","rien","ne","quitte","cet","onglet","qui","a","rendu","la","decision","une","entreprise","secteur","prive","lrpsp","art","12","1","un","organisme","public","loi","sur","l'acces","art","65","2","un","organisme","de","sante","lrss","art","65","ton","nom","l'organisation","qui","a","decide","la","date","de","la","decision","si","tu","la","connais","la","decision","en","une","phrase","je","veux","aussi","presenter","mes","observations","a","une","personne","en","mesure","de","reviser","la","decision","produire","la","demande","ta","demande","la","demande","ne","vit","que","dans","cet","onglet","comme","les","lettres","du","panneau","mes","renseignements","copier","telecharger","txt","imprimer","pdf","l'horloge","des","droits","une","fois","la","demande","envoyee","consigne-la","elle","devient","une","demarche","scellee","de","ton","cerveau","avec","son","echeance","de","suivi","a","30","jours","et","son","rappel","ics","consigner","la","demande","dans","mon","cerveau","echeance","telecharger","le","rappel","ics"],"empreinte":"2d61db319388259ac0dec035e84a53e778ddb83017bb710f5fd5c8c8cd746a15","merkle":{"feuille":59,"chemin":[{"cote":"gauche","digest":"c8a66a7ae450e25ed9b9e3364fd4d3696b76c31484ee4192c2f8eda2d7ac8c42"},{"cote":"gauche","digest":"4eb3ede35f719825a316028f739f88ddaed076f5355a0cc76483b729626b9636"},{"cote":"droite","digest":"65aae9545d77d0a53164c290f5355