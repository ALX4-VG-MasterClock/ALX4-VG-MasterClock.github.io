ctement la différence avec un vrai pisteur — sa mémoire à lui persiste, et la section 36 t’apprend à mesurer la tienne.","mots":["50","la","visite","guidee","cote","pisteur","cette","visite","vue","par","celui","qui","recolte","retourne","la","carte","voici","ta","propre","visite","racontee","du","cote","du","pisteur","ce","qu","un","recoltant","voit","calcule","et","deduit","d","un","seul","chargement","de","page","avec","les","techniques","nommees","depuis","la","recherche","sur","les","transits","empreinte","referent","parametres","d","url","inventaire","de","requetes","horodatage","la","demonstration","est","locale","et","ne","garde","rien","ferme","ou","recharge","et","elle","est","vierge","a","nouveau","commencer","la","visite","cote","pisteur","tout","effacer","la","demo","ne","garde","rien","rien","de","cette","demonstration","n","est","consigne","scelle","ni","envoye","elle","existe","dans","la","memoire","de","cette","page","le","temps","de","la","visite","c","est","exactement","la","difference","avec","un","vrai","pisteur","sa","memoire","a","lui","persiste","et","la","section","36","t","apprend","a","mesurer","la","tienne"],"empreinte":"2736a91e6af8aad369ff365c93da47495159d9a4f1af39682d7ecbc084e13404","merkle":{"feuille":167,"chemin":[{"cote":"gauche","digest":"4ecd1342785ddfa39b81de98ab7ea8567739fdf5fe81c3f4df7e2e97dbb8312b"},{"cote":"gauche","digest":"12d1ca63e239a21fee0a8b47ce5c7b48169d5bd4c7298e6fd85551c4cfab7b3d"},{"cote":"gauche","digest":"28e127a71da2651f3f5194f9f29e8af17404ffb98edd928007e2e75520fc1473"},{"cote":"droite","digest":"2dcf1cf2891bd42cbe2ce49b78d962a996473737c0415fb6b65b15618afe4b54"},{"cote":"droite","digest":"4acf95756dc50b307b1efe3898b933a1db0eb2acc634626b03c66fd31f4d4830"},{"cote":"gauche","digest":"cd8f0b5a9f787cccfd49de8804f2a519b0f6ce91b845b7380fa73ac26941cff0"},{"cote":"droite","digest":"61783b3d0e30b8ee5d94f4bc62cd810067545dfb8758b360571efe39278cbf9c"},{"cote":"gauche","digest":"35bb3360f798e767433de9562880ae5e4200860cfb53e7f0